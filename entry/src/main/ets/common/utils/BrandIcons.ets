/**
 * 品牌图标定义
 */
export class BrandIconDef {
  /** rawfile 文件名（不含目录与扩展名） */
  readonly file: string;
  /** 显示名 */
  readonly label: string;
  /** 搜索关键词（小写，空格分隔，拼音/英文） */
  readonly keywords: string;

  constructor(file: string, label: string, keywords: string) {
    this.file = file;
    this.label = label;
    this.keywords = keywords;
  }
}

